# Frontend Environment Configuration

# API URL - set this to your backend API endpoint
# Development: http://localhost:8000
# Production (Kubernetes): http://bsp-api-service:8000 or your ingress URL
# VITE_PUBLIC_API_URL=http://localhost:8000
VITE_PUBLIC_API_URL=

# Hosted build (the website): static files, cluster only, no local pipeline.
# Build with `npm run build:hosted` and set VITE_PUBLIC_API_URL to the API's address.
# VITE_HOSTED=1
