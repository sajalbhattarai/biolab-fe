# rasttk — BV-BRC CLI (rast-* commands) incremental annotation pipeline
# ubuntu:22.04 base; bvbrc-cli-ubuntu-22-1.048.deb installed via apt

Bootstrap: docker
From: ubuntu:22.04

%files
    entrypoint.sh /opt/rasttk/entrypoint.sh
    scripts       /opt/rasttk/scripts
    postproc      /opt/rasttk/postproc
    LICENSE.md    /opt/rasttk/LICENSE.md
    VERSIONS      /opt/rasttk/VERSIONS

%labels
    org.opencontainers.image.title         rasttk
    org.opencontainers.image.description   "RAST-TK / BV-BRC annotation (upstream BV-BRC CLI .deb)"
    org.opencontainers.image.source        https://github.com/margie-annotation/margie-pipeline
    org.opencontainers.image.licenses      GPL-3.0-or-later

%environment
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PATH=/opt/rasttk/scripts:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export RASTTK_NO_BUNDLED_DB=true
    export PYTHONDONTWRITEBYTECODE=1

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1

    # libsoap-lite-perl + libplack-perl required for local GenomeAnnotation PSGI service (plackup + SOAP::Lite)
    apt-get update && apt-get install -y --no-install-recommends \
            wget ca-certificates libssl-dev libdb5.3 python3 tini bash \
            libsoap-lite-perl libplack-perl \
     && rm -rf /var/lib/apt/lists/*

    # Patch deprecated tutorial endpoint → production endpoint (baked into deb URL table)
    wget -q https://github.com/BV-BRC/BV-BRC-CLI/releases/download/1.048/bvbrc-cli-ubuntu-22-1.048.deb \
            -O /tmp/bvbrc.deb \
     && apt-get update \
     && apt-get install -y --no-install-recommends /tmp/bvbrc.deb \
     && rm /tmp/bvbrc.deb \
     && rm -rf /var/lib/apt/lists/* \
     && find /usr/share/bv-brc/deployment/lib -name "*.pm" -o -name "*.py" -o -name "*.js" | xargs grep -rl 'tutorial\.theseed\.org/services/genome_annotation' | xargs sed -i 's|tutorial\.theseed\.org/services/genome_annotation|p3.theseed.org/services/genome_annotation|g'

    chmod -R a+rX /opt/rasttk \
     && find /opt/rasttk -type f \( -name '*.sh' -o -name '*.py' \) -exec chmod a+x {} + \
     && ln -sf /opt/rasttk/entrypoint.sh /usr/local/bin/run \
     && mkdir -p /input /output /db

%runscript
    exec /usr/bin/tini -- /usr/local/bin/run "$@"
