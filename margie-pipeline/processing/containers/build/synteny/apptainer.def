Bootstrap: docker
From: python:3.11-slim

%files
    entrypoint.sh /opt/synteny/entrypoint.sh
    scripts      /opt/synteny/
    LICENSE.md    /opt/synteny/LICENSE.md
    VERSIONS      /opt/synteny/VERSIONS

%labels
    org.opencontainers.image.title       synteny
    org.opencontainers.image.description "Annotation transfer / gene rescue via Liftoff"
    org.opencontainers.image.source      https://github.com/sajalbhattarai/margie-pipeline
    org.opencontainers.image.vendor      margie-annotation
    org.opencontainers.image.licenses    "GPL-3.0-or-later AND MIT AND BSD-3-Clause"
    org.opencontainers.image.version     liftoff-1.6.3.2+minimap2-2.28

%environment
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    LIFTOFF_VERSION=1.6.3.2
    MINIMAP2_VERSION=2.28

    apt-get update && apt-get install -y --no-install-recommends \
            tini bash ca-certificates wget \
            build-essential zlib1g-dev libbz2-dev liblzma-dev \
            libcurl4-openssl-dev libssl-dev \
     && rm -rf /var/lib/apt/lists/*

    # Compile minimap2 from source (works on amd64 and arm64)
    cd /tmp \
     && wget -q "https://github.com/lh3/minimap2/archive/refs/tags/v${MINIMAP2_VERSION}.tar.gz" \
     && tar -xzf "v${MINIMAP2_VERSION}.tar.gz" \
     && cd "minimap2-${MINIMAP2_VERSION}" \
     && make -j"$(nproc)" \
     && strip minimap2 \
     && install -m 755 minimap2 /usr/local/bin/minimap2 \
     && cd / && rm -rf /tmp/minimap2-* /tmp/v${MINIMAP2_VERSION}.tar.gz

    # liftoff==1.6.3.2 pins pysam==0.16.0.1 which uses use_2to3 (removed in
    # setuptools>=58) — install deps manually with modern versions, then
    # install liftoff itself with --no-deps to skip the pinned pysam.
    pip install --no-cache-dir pysam networkx gffutils biopython numpy \
     && pip install --no-cache-dir --no-deps "liftoff==${LIFTOFF_VERSION}"

    chmod -R a+rX /opt/synteny \
     && find /opt/synteny -type f \( -name '*.sh' -o -name '*.py' \) -exec chmod a+x {} + \
     && ln -sf /opt/synteny/entrypoint.sh /usr/local/bin/run \
     && mkdir -p /input /output

    printf '{\n  "tool": "synteny",\n  "liftoff_version": "%s",\n  "minimap2_version": "%s",\n  "base_image": "python:3.11-slim"\n}\n' \
        "${LIFTOFF_VERSION}" "${MINIMAP2_VERSION}" > /etc/pipeline-build.json

    # Remove build-only packages
    apt-get purge -y build-essential && apt-get autoremove -y

%runscript
    exec /usr/local/bin/run "$@"
